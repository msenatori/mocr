# Copy to config.env (gitignored) and edit. Loaded automatically by prs.sh and
# bot-token.sh; real environment variables override anything set here.

# --- Which repositories to review -------------------------------------------
# Two ways. Explicit wins when any REVIEW_REPO_* is set.

# 1. Explicit, one variable per checkout. Repos can live anywhere, and the
#    reviewed set is a deliberate choice rather than whatever is in a folder.
#REVIEW_REPO_API=$HOME/src/api
#REVIEW_REPO_WEB=$HOME/src/web
#REVIEW_REPO_WORKER=$HOME/other/place/worker

# 2. Scan a folder for checkouts. Used when no REVIEW_REPO_* is set.
#REVIEW_REPOS=$HOME/src

# --- Posting identity --------------------------------------------------------
# The GitHub organization (or user) the App is installed on.
REVIEW_ORG=your-org

# App ID from the app settings page. The key never lives in this repo — this
# only points at it. Keep it chmod 600, outside any checkout.
REVIEW_APP_ID=123456
REVIEW_APP_KEY=$HOME/.config/mocr/review-bot.pem

# Paths containing spaces must be quoted: this file is sourced by the shell,
# so REVIEW_REPO_API=$HOME/My Repos/api runs `Repos/api` as a command.

# --- Default review-queue filters -------------------------------------------
# Flags still override per run. `-A` drops the days, limit and draft filters,
# but not the ordering.
REVIEW_DAYS=14          # only PRs updated in the last N days
REVIEW_LIMIT=1          # at most N PRs per run
REVIEW_ORDER=random     # random | oldest — which PR a capped run picks
REVIEW_SKIP_DRAFTS=true

# Where published reviews are recorded, one `owner/name#pr` per line.
# Defaults to reviews/ next to this file, and is gitignored. Empty turns it off.
# REVIEW_LOG_DIR=
